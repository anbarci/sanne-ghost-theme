# Türkiye Radar: tüm değerler isteğe bağlı. Anahtarları yönetim panelinden de girebilirsiniz
# (orada AES-256-GCM ile şifreli saklanır). Burada verilen değer paneldekinden önceliklidir.
# Değerin yanına yorum yazmayın; Docker env_file bunu değerin parçası sayar.

# Sunucu (varsayılan: sadece bu makine)
HOST=127.0.0.1
PORT=3120
# Caddy/nginx gibi bir ters vekil arkasındaysa 1 yapın (giriş sınırı gerçek istemci adresine göre işler).
# Vekil yokken 1 yapmayın.
RADAR_TRUST_PROXY=
# Şifreleme ana anahtarı. Boşsa runtime/.master.key otomatik üretilir.
RADAR_SECRET=

# TCMB EVDS3: evds3.tcmb.gov.tr > Profilim > API Key
EVDS_API_KEY=
# NASA FIRMS: firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=
# EPİAŞ Şeffaflık Platformu üyeliği
EPIAS_USER=
EPIAS_PASS=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
